RewriteEngine On

# 1. Allow authorization headers
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

# 2. Dynamic Sitemap rewrite
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# 3. Torob & Emalls Product Discovery Feed
RewriteRule ^torob\.json$ api/torob_feed.php [L]
RewriteRule ^torob$ api/torob_feed.php [L]

# 4. Clean SEF URLs for Products, Doctors, Articles, Clinics
RewriteRule ^product/([0-9]+)(/.*)?$ product_details.php?id=$1 [QSA,L]
RewriteRule ^doctor/([0-9]+)(/.*)?$ doctor_profile.php?id=$1 [QSA,L]
RewriteRule ^article/([a-zA-Z0-9_-]+)$ knowledge_base.php?article=$1 [QSA,L]
RewriteRule ^clinic/([a-zA-Z0-9_-]+)$ organization_profile.php?slug=$1 [QSA,L]

# 5. Remove .php extension from URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# 4. Prevent directory listing
Options -Indexes

# 5. Gzip / Deflate Compression for Core Web Vitals & Google Speed Ranking
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff
</IfModule>

# 6. Browser Caching (Expires & Cache-Control)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Static Assets & Web Fonts (1 Year)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS & JavaScript (1 Month)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    
    # HTML & Data (Dynamic - 1 Hour)
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# 7. Security Headers for Search Quality & User Trust
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
</IfModule>

# 8. PWA Service Worker Header Rules
<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Service-Worker-Allowed "/"
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </IfModule>
</Files>

# 9. Block access to sensitive configuration, database, container and credential files
<FilesMatch "(^\..*|\.(env|env\.example|sql|log|md|git|gitignore|yml|yaml|dockerignore)|accounts_credentials.*|credentials.*)$">
    Require all denied
</FilesMatch>

# 10. Custom Branded Error Documents
ErrorDocument 403 /asena/asena-enterprise/403.php
ErrorDocument 404 /asena/asena-enterprise/404.php
ErrorDocument 500 /asena/asena-enterprise/500.php
ErrorDocument 502 /asena/asena-enterprise/502.php
ErrorDocument 503 /asena/asena-enterprise/503.php
ErrorDocument 504 /asena/asena-enterprise/504.php
