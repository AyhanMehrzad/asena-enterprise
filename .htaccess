RewriteEngine On

# 0. Pharmacy, Websites & Tenant Site Enterprise Route Handling
RewriteRule ^pharmacy/$ /pharmacy [R=301,L]
RewriteRule ^pharmacy$ pharmacy.php [QSA,L]
RewriteRule ^websites/$ /websites [R=301,L]
RewriteRule ^websites$ websites.php [QSA,L]
RewriteRule ^site/?$ site.php [QSA,L]

# 0.1 Canonical Recovery 301 Redirects for Broken /product/ Relative Crawler Permutations
RewriteRule ^product/?$ /shop [R=301,L]
RewriteRule ^product/product_details(?:\.php)?$ /shop [R=301,L]
RewriteRule ^product/(shop|pharmacy|booking|websites|calculator|interactions|organizations|subscriptions|knowledge_base|charity|rewards|about|login|cart|contact|terms|privacy|index)(.*)$ /$1$2 [R=301,L]

# 1. Allow authorization headers
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

# 2. Dynamic Sitemap rewrite
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# 3. Torob & Emalls Product Discovery Feed
RewriteRule ^torob\.json$ api/torob_feed.php [L]
RewriteRule ^torob$ api/torob_feed.php [L]

# 3.8 Canonical 301 Redirects for Legacy Query Routes
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+product_details(?:\.php)?\?id=([0-9]+) [NC]
RewriteRule ^product_details(?:\.php)?$ /product/%1? [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+doctor_profile(?:\.php)?\?id=([0-9]+) [NC]
RewriteRule ^doctor_profile(?:\.php)?$ /doctor/%1? [R=301,L]

# 4. Clean SEF URLs for Products, Doctors, Articles, Clinics
RewriteRule ^product/([0-9]+)(/.*)?$ product_details.php?id=$1 [QSA,L]
RewriteRule ^doctor/([0-9]+)(/.*)?$ doctor_profile.php?id=$1 [QSA,L]
RewriteRule ^article/([a-zA-Z0-9_-]+)$ knowledge_base.php?article=$1 [QSA,L]
RewriteRule ^clinic/([a-zA-Z0-9_-]+)$ organization_profile.php?slug=$1 [QSA,L]
RewriteRule ^@([a-zA-Z0-9_\-]+)$ site.php?slug=$1 [QSA,L]
RewriteRule ^site/([a-zA-Z0-9_\-]+)$ site.php?slug=$1 [QSA,L]

# 5. Clean Extensionless URLs (Remove .php from routes)
# 5.1 External 301 Redirect for GET/HEAD: /path/file.php -> /path/file
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !actions/ [NC]
RewriteCond %{REQUEST_URI} !api/ [NC]
RewriteRule ^ /%1 [R=301,L]

# 5.2 Internal Rewrite: /path/file -> /path/file.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [QSA,L]

# 4. Prevent directory listing
Options -Indexes

# 5. Gzip / Deflate Compression for Core Web Vitals & Google Speed Ranking
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff
</IfModule>

# 6. Browser Caching (Expires & Cache-Control)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Static Assets & Web Fonts (1 Year)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS & JavaScript (1 Month)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    
    # HTML & Data (Dynamic - 1 Hour)
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    # 1 Year Immutable Browser & CDN Cache for Static Assets & Fonts
    <FilesMatch "\.(css|js|woff2|woff|ttf|svg|png|jpg|jpeg|webp|ico)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
</IfModule>

# 7. Security Headers for Search Quality & User Trust & CDN Iran Compatibility
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header unset X-XSS-Protection
    Header always unset X-XSS-Protection
    
    # Suppress Alt-Svc to prevent browsers from attempting blocked HTTP/3 (UDP 443) inside Iran
    Header unset Alt-Svc
    Header always unset Alt-Svc
</IfModule>

# 8. PWA Service Worker Header Rules
<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Service-Worker-Allowed "/"
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </IfModule>
</Files>

# 9. Block access to sensitive configuration, database, container and credential files
<FilesMatch "(^\..*|\.(env|env\.example|sql|log|md|git|gitignore|yml|yaml|dockerignore)|accounts_credentials.*|credentials.*)$">
    Require all denied
</FilesMatch>

# 10. Custom Branded Error Documents (Root Production Compatible)
ErrorDocument 403 /403.php
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
ErrorDocument 502 /502.php
ErrorDocument 503 /503.php
ErrorDocument 504 /504.php
