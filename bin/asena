#!/usr/bin/env php
<?php
/**
 * ASENA Enterprise - Command Line Interface (CLI)
 * 
 * Usage:
 *   php bin/asena status
 *   php bin/asena set-tier <basic|standard|premium|pharmacy|enterprise>
 *   php bin/asena package --tier=<tier> [--name=<client_name>]
 *   php bin/asena autoship:run
 *   php bin/asena migrate
 */

define('ASENA_ROOT', dirname(__DIR__));
require_once ASENA_ROOT . '/includes/Feature.php';

// CLI Output Formatting Helpers
function out(string $msg, string $color = '37'): void {
    echo "\033[{$color}m{$msg}\033[0m\n";
}
function success(string $msg): void { out("✔ $msg", '32'); }
function info(string $msg): void { out("ℹ $msg", '36'); }
function warn(string $msg): void { out("⚠ $msg", '33'); }
function error(string $msg): void { out("✖ $msg", '31'); }

$cmd = $argv[1] ?? 'help';

switch ($cmd) {
    case 'status':
        showStatus();
        break;

    case 'set-tier':
        $tier = $argv[2] ?? null;
        if (!$tier) {
            error("لطفاً نام نسخه را وارد کنید: basic, standard, premium, pharmacy, enterprise");
            exit(1);
        }
        setTierInEnv($tier);
        break;

    case 'package':
        $options = parseArgs(array_slice($argv, 2));
        $tier = $options['tier'] ?? 'enterprise';
        $clientName = $options['name'] ?? 'Client';
        packageDistribution($tier, $clientName);
        break;

    case 'autoship:run':
        runAutoshipWorker();
        break;

    case 'escrow:sync-post':
        runEscrowPostSyncWorker();
        break;

    case 'escrow:release-matured':
        runEscrowReleaseWorker();
        break;

    case 'escrow:weekly-payout':
        runEscrowWeeklyPayoutWorker();
        break;

    case 'b2b:rfq-expire':
        runRfqExpireWorker();
        break;

    case 'flash:sync':
        runFlashSaleSyncWorker();
        break;

    case 'system:health':
        runSystemHealthCheck();
        break;

    case 'db:backup':
        runDatabaseBackup();
        break;

    case 'db:restore':
        runDatabaseRestore($argv[2] ?? '');
        break;

    case 'help':
    default:
        showHelp();
        break;
}

/**
 * Display system status & feature matrix
 */
function showStatus(): void {
    out("\n==================================================", '34');
    out("       ASENA ENTERPRISE - STATUS & TIERS          ", '34');
    out("==================================================\n", '34');

    $tier = Feature::currentTier();
    $name = Feature::tierName();

    info("نسخه فعال (Active Tier): \033[1m$tier\033[0m ($name)");
    out("\nقابلیت‌های فعال (Active Features):", '33');

    $allTiers = Feature::allTiers();
    $activeFeatures = $allTiers[$tier]['features'] ?? [];

    foreach ($activeFeatures as $feat) {
        out("  ✔ $feat", '32');
    }

    out("\nنسخه‌های قابل ارائه برای خریداران:", '36');
    foreach ($allTiers as $code => $data) {
        $marker = ($code === $tier) ? '➔ [ACTIVE]' : ' ';
        out("  $marker {$code}: {$data['name']} (" . count($data['features']) . " قابلیت)");
    }

    // Database check
    out("\nوضعیت دیتابیس:", '33');
    try {
        require_once ASENA_ROOT . '/includes/db.php';
        /** @var PDO $pdo */
        $tables = $pdo->query("SHOW TABLES")->fetchAll(PDO::FETCH_COLUMN);
        success("اتصال موفق به دیتابیس (" . count($tables) . " جدول پیدا شد)");
    } catch (Exception $e) {
        warn("عدم امکان اتصال به دیتابیس: " . $e->getMessage());
    }
    echo "\n";
}

/**
 * Set active tier in .env file
 */
function setTierInEnv(string $tier): void {
    $validTiers = array_keys(Feature::allTiers());
    if (!in_array($tier, $validTiers, true)) {
        error("نسخه نامعتبر است! گزینه‌های مجاز: " . implode(', ', $validTiers));
        exit(1);
    }

    $envFile = ASENA_ROOT . '/.env';
    if (!file_exists($envFile)) {
        $example = ASENA_ROOT . '/.env.example';
        if (file_exists($example)) {
            copy($example, $envFile);
        } else {
            file_put_contents($envFile, "ASENA_TIER=enterprise\n");
        }
    }

    $content = file_get_contents($envFile);
    if (preg_match('/^ASENA_TIER=.*$/m', $content)) {
        $content = preg_replace('/^ASENA_TIER=.*$/m', "ASENA_TIER={$tier}", $content);
    } else {
        $content .= "\nASENA_TIER={$tier}\n";
    }

    file_put_contents($envFile, $content);
    success("نسخه با موفقیت به «{$tier}» تغییر یافت.");
    Feature::setTier($tier);
    info("عنوان نسخه: " . Feature::tierName());
}

/**
 * Package a standalone distribution zip ready for customer hosting (cPanel/DirectAdmin)
 */
function packageDistribution(string $tier, string $clientName): void {
    $validTiers = array_keys(Feature::allTiers());
    if (!in_array($tier, $validTiers, true)) {
        error("نسخه درخواستی نامعتبر است: $tier");
        exit(1);
    }

    $dateStr = date('Ymd_His');
    $safeName = preg_replace('/[^a-zA-Z0-9_-]/', '_', $clientName);
    $buildId = "asena_{$tier}_{$safeName}_{$dateStr}";
    $distDir = ASENA_ROOT . '/dist';
    $buildDir = "{$distDir}/{$buildId}";
    $zipFile = "{$distDir}/{$buildId}_cPanel_Ready.zip";

    if (!is_dir($distDir)) {
        mkdir($distDir, 0777, true);
    }

    info("در حال آماده‌سازی پکیج تجاری برای: $clientName (نسخه: $tier)");
    info("مسیر ساخت موقت: $buildDir");

    mkdir($buildDir, 0777, true);

    // Exclude patterns
    $excludes = [
        '.git',
        'dist',
        'tests',
        '.vscode',
        'bin',
        'uploads/*',
        '*.zip',
        '*.pdf',
        '*.log',
    ];

    $excludeFlags = '';
    foreach ($excludes as $exc) {
        $excludeFlags .= " --exclude=" . escapeshellarg($exc);
    }

    // Rsync to build directory
    $rsyncCmd = "rsync -avq {$excludeFlags} " . escapeshellarg(ASENA_ROOT . '/') . ' ' . escapeshellarg($buildDir . '/');
    shell_exec($rsyncCmd);

    // Write customized .env
    $clientEnv = <<<ENV
# ASENA Customer Deployment Configuration
APP_NAME="ASENA {$tier}"
ASENA_TIER={$tier}
APP_ENV=production
APP_DEBUG=false

# Database Configuration (Enter customer's cPanel MySQL details)
DB_HOST=localhost
DB_NAME=asena_client
DB_USER=cpanel_user
DB_PASS=cpanel_password

# Base URL
BASE_URL="http://yourdomain.com/"
ENV;
    file_put_contents($buildDir . '/.env', $clientEnv);

    // Create automated web installer in root for cPanel
    $installerPhp = <<<PHP
<?php
// ASENA One-Click Web Installer
if (file_exists(__DIR__ . '/config.php') && filesize(__DIR__ . '/config.php') > 50) {
    die("سامانه قبلاً نصب شده است. برای نصب مجدد فایل config.php را حذف کنید یا وارد پنل شوید: <a href='login.php'>ورود</a>");
}

if (\$_SERVER['REQUEST_METHOD'] === 'POST') {
    \$host = trim(\$_POST['db_host'] ?? 'localhost');
    \$dbname = trim(\$_POST['db_name'] ?? '');
    \$user = trim(\$_POST['db_user'] ?? '');
    \$pass = trim(\$_POST['db_pass'] ?? '');

    try {
        \$pdo = new PDO("mysql:host=\$host;dbname=\$dbname;charset=utf8mb4", \$user, \$pass, [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION
        ]);

        \$sqlFile = __DIR__ . '/petshop_db.sql';
        if (file_exists(\$sqlFile)) {
            \$sql = file_get_contents(\$sqlFile);
            \$pdo->exec(\$sql);
        }

        \$configContent = "<?php\\ndefine('DB_HOST', '{\$host}');\\ndefine('DB_NAME', '{\$dbname}');\\ndefine('DB_USER', '{\$user}');\\ndefine('DB_PASS', '{\$pass}');\\n";
        file_put_contents(__DIR__ . '/config.php', \$configContent);

        header('Location: login.php?installed=1');
        exit;
    } catch (Exception \$e) {
        \$error = "خطا در اتصال به دیتابیس: " . \$e->getMessage();
    }
}
?>
<!DOCTYPE html>
<html dir="rtl" lang="fa">
<head>
    <meta charset="utf-8">
    <title>نصب خودکار سامانه آسنا | ASENA Installer</title>
    <style>
        body { font-family: system-ui, sans-serif; background: #001a48; color: #fff; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
        .card { background: #fff; color: #1e293b; padding: 32px; border-radius: 20px; width: 100%; max-width: 440px; box-shadow: 0 20px 40px rgba(0,0,0,0.3); }
        h1 { margin-top: 0; color: #002d72; font-size: 20px; text-align: center; }
        label { display: block; margin-top: 14px; font-weight: bold; font-size: 13px; }
        input { width: 100%; padding: 10px 12px; margin-top: 6px; border: 1px solid #cbd5e1; border-radius: 10px; box-sizing: border-box; }
        button { width: 100%; margin-top: 24px; padding: 12px; background: #002d72; color: #fff; font-weight: bold; border: none; border-radius: 10px; cursor: pointer; font-size: 14px; }
        .err { background: #fee2e2; color: #991b1b; padding: 10px; border-radius: 8px; margin-bottom: 14px; font-size: 13px; }
    </style>
</head>
<body>
    <div class="card">
        <h1>راه‌اندازی سامانه آسنا (نسخه {$tier})</h1>
        <?php if (!empty(\$error)): ?><div class="err"><?= htmlspecialchars(\$error) ?></div><?php endif; ?>
        <form method="POST">
            <label>هاست دیتابیس (معمولاً localhost):</label>
            <input type="text" name="db_host" value="localhost" required>
            <label>نام پایگاه داده (Database Name):</label>
            <input type="text" name="db_name" required>
            <label>نام کاربری دیتابیس (User):</label>
            <input type="text" name="db_user" required>
            <label>رمز عبور دیتابیس (Password):</label>
            <input type="password" name="db_pass">
            <button type="submit">نصب پایگاه داده و شروع کار</button>
        </form>
    </div>
</body>
</html>
PHP;
    file_put_contents($buildDir . '/install.php', $installerPhp);

    // Create ZIP archive
    info("در حال فشرده‌سازی و ساخت فایل zip نهایی...");
    $zipCmd = "cd " . escapeshellarg($buildDir) . " && zip -rq " . escapeshellarg($zipFile) . " .";
    shell_exec($zipCmd);

    // Clean up temporary build folder
    shell_exec("rm -rf " . escapeshellarg($buildDir));

    $fileSizeMb = round(filesize($zipFile) / 1048576, 2);
    success("پکیج با موفقیت آماده شد!");
    out("فایل زیپ نهایی: $zipFile ({$fileSizeMb} MB)", '32');
    out("کافی است این فایل را در File Manager هاست خریدار (cPanel/DirectAdmin) آپلود کرده و اکسترکت کنید.", '36');
}

/**
 * Headless Autoship Worker Runner (Chewy.com Benchmark)
 */
function runAutoshipWorker(): void {
    info("در حال اجرای موتور بررسی و ارسال سفارشات خودکار دوره‌ای (Autoship Engine)...");
    require_once ASENA_ROOT . '/includes/db.php';
    require_once ASENA_ROOT . '/includes/AutoshipService.php';
    require_once ASENA_ROOT . '/includes/SmsService.php';

    global $pdo;
    $autoship = new AutoshipService($pdo);
    $sms = new SmsService();

    // 1. Process orders due today or earlier
    $dueList = $autoship->getDueSubscriptions();
    info("تعداد اشتراک‌های سررسید شده برای پردازش: " . count($dueList));

    $processed = 0;
    foreach ($dueList as $sub) {
        $subId = (int)$sub['id'];
        $userId = (int)$sub['user_id'];
        $orderId = $autoship->shipNow($subId, $userId);

        if ($orderId) {
            $processed++;
            success("سفارش #{$orderId} برای کاربر {$sub['user_name']} ({$sub['user_phone']}) با موفقیت ایجاد شد.");
            
            if (!empty($sub['user_phone'])) {
                $text = "آسنا: اشتراک ادواری شما (#{$subId}) پردازش گردید و سفارش (#{$orderId}) در حال آماده‌سازی است.";
                $sms->send($sub['user_phone'], $text);
            }
        }
    }

    // 2. Proactive 3-day reminder SMS
    $upcoming = $autoship->getUpcomingReminders(3);
    info("تعداد یادآوری‌های ارسالی برای سفارشات ۳ روز آینده: " . count($upcoming));
    foreach ($upcoming as $up) {
        if (!empty($up['user_phone'])) {
            $text = "آسنا: سفارش ادواری (Autoship) شما ۳ روز دیگر ارسال خواهد شد. در صورت نیاز به تغییر اقلام یا تعویق تاریخ، به پنل کاربری مراجعه کنید.";
            $sms->send($up['user_phone'], $text);
        }
    }

    success("پردازش اتوشیپ با موفقیت تکمیل شد ($processed سفارش پردازش شد).");
}

/**
 * Expire Outdated RFQ Quotes (Alibaba.com Benchmark)
 */
function runRfqExpireWorker(): void {
    info("در حال بررسی و منقضی‌سازی استعلام‌های گذشته از تاریخ اعتبار (RFQ Tender Expirer)...");
    require_once ASENA_ROOT . '/includes/db.php';
    $pdo = $GLOBALS['pdo'];

    $stmt = $pdo->prepare("
        UPDATE b2b_rfqs 
        SET status = 'expired' 
        WHERE status = 'quoted' AND quote_valid_until < CURRENT_DATE
    ");
    $stmt->execute();
    $count = $stmt->rowCount();
    success("تعداد {$count} پیش‌فاکتور منقضی شده با موفقیت علامت‌گذاری شدند.");
}

/**
 * Sync and Expire Flash Deals (Digikala.com Benchmark)
 */
function runFlashSaleSyncWorker(): void {
    info("در حال همگام‌سازی و بررسی پیشنهادات شگفت‌انگیز (Flash Sales)...");
    require_once ASENA_ROOT . '/includes/db.php';
    $pdo = $GLOBALS['pdo'];

    $stmt = $pdo->prepare("
        UPDATE flash_sales 
        SET is_active = 0 
        WHERE is_active = 1 AND (ends_at <= NOW() OR claimed_count >= stock_quota)
    ");
    $stmt->execute();
    $count = $stmt->rowCount();
    success("تعداد {$count} پیشنهاد شگفت‌انگیز خاتمه‌یافته یا تکمیل ظرفیت با موفقیت غیرفعال شدند.");
}

/**
 * Full Enterprise System Diagnostic Health Check
 */
function runSystemHealthCheck(): void {
    out("\n==================================================", '34');
    out("       ASENA ENTERPRISE - SYSTEM HEALTH CHECK     ", '34');
    out("==================================================\n", '34');

    // 1. PHP Version
    info("نسخه PHP: " . phpversion());

    // 2. Database Connection
    require_once ASENA_ROOT . '/includes/db.php';
    $db = $GLOBALS['pdo'] ?? null;
    try {
        if ($db) {
            $dbName = $db->query("SELECT DATABASE()")->fetchColumn();
            $tables = $db->query("SHOW TABLES")->fetchAll(PDO::FETCH_COLUMN);
            success("پایگاه داده: {$dbName} (متصل، شامل " . count($tables) . " جدول)");
        } else {
            error("اتصال به دیتابیس برقرار نشد.");
        }
    } catch (Exception $e) {
        error("خطای دیتابیس: " . $e->getMessage());
    }

    // 3. Writable Directories
    $dirs = [
        ASENA_ROOT . '/uploads',
        ASENA_ROOT . '/uploads/prescriptions',
        ASENA_ROOT . '/dist'
    ];
    foreach ($dirs as $d) {
        if (!is_dir($d)) @mkdir($d, 0755, true);
        if (is_writable($d)) {
            success("دایرکتوری قابل نوشتن: " . basename($d));
        } else {
            warn("دایرکتوری فاقد دسترسی نوشتن: " . basename($d));
        }
    }

    // 4. Feature Matrix Check
    $tier = Feature::currentTier();
    info("نسخه فعال: {$tier} (" . Feature::tierName() . ")");
    echo "\n";
}

/**
 * Automated Database Backup (DevOps Tooling)
 */
function runDatabaseBackup(): void {
    info("در حال تهیه نسخه پشتیبان کامل از پایگاه داده (Database Backup)...");
    require_once ASENA_ROOT . '/includes/db.php';
    $pdo = $GLOBALS['pdo'];

    $backupDir = ASENA_ROOT . '/database/backups';
    if (!is_dir($backupDir)) {
        @mkdir($backupDir, 0755, true);
    }

    $filename = 'backup_' . date('Y_m_d_His') . '.sql';
    $targetPath = $backupDir . '/' . $filename;

    $tables = $pdo->query("SHOW TABLES")->fetchAll(PDO::FETCH_COLUMN);
    $handle = fopen($targetPath, 'w');
    if (!$handle) {
        error("امکان ایجاد فایل بکاپ وجود ندارد.");
        return;
    }

    fwrite($handle, "-- ASENA Enterprise Master Database Backup\n");
    fwrite($handle, "-- Generated: " . date('Y-m-d H:i:s') . "\n\n");
    fwrite($handle, "SET FOREIGN_KEY_CHECKS=0;\n\n");

    foreach ($tables as $t) {
        $createSql = $pdo->query("SHOW CREATE TABLE `$t`")->fetch(PDO::FETCH_ASSOC);
        fwrite($handle, "DROP TABLE IF EXISTS `$t`;\n");
        fwrite($handle, $createSql['Create Table'] . ";\n\n");

        $rows = $pdo->query("SELECT * FROM `$t`")->fetchAll(PDO::FETCH_ASSOC);
        if (!empty($rows)) {
            foreach ($rows as $row) {
                $cols = array_map(fn($c) => "`$c`", array_keys($row));
                $vals = array_map(fn($v) => $v === null ? "NULL" : $pdo->quote((string)$v), array_values($row));
                fwrite($handle, "INSERT INTO `$t` (" . implode(', ', $cols) . ") VALUES (" . implode(', ', $vals) . ");\n");
            }
            fwrite($handle, "\n");
        }
    }

    fwrite($handle, "SET FOREIGN_KEY_CHECKS=1;\n");
    fclose($handle);

    $sizeKb = round(filesize($targetPath) / 1024, 2);
    success("نسخه پشتیبان با موفقیت در مسیر زیر ایجاد شد ($sizeKb KB):");
    out("  $targetPath\n", '32');
}

/**
 * Iran Post Web Service Delivery Verification Worker
 */
function runEscrowPostSyncWorker(): void {
    info("در حال استعلام وضعیت بسته‌های پستی در جریان از وب‌سرویس‌های لجستیک (Postex & Iran Post)...");
    require_once ASENA_ROOT . '/includes/App.php';
    
    $postexRes = App::postex()->syncInTransitParcels();
    $iranPostRes = App::iranPost()->syncInTransitShipments();

    $totalChecked = ($postexRes['checked_count'] ?? 0) + ($iranPostRes['checked_count'] ?? 0);
    $totalDelivered = ($postexRes['delivered_count'] ?? 0) + ($iranPostRes['delivered_count'] ?? 0);
    $totalInTransit = ($postexRes['in_transit_count'] ?? 0) + ($iranPostRes['in_transit_count'] ?? 0);

    success("بررسی بسته‌های پستی به اتمام رسید:");
    out("  تعداد کل مرسولات بررسی شده: {$totalChecked}");
    out("  تعداد مرسولات تحویل داده شده (شروع مهلت ۷ روزه): {$totalDelivered}", '32');
    out("  تعداد مرسولات در مسیر: {$totalInTransit}", '33');
}

/**
 * Escrow 7-Day Guarantee Matured Release Worker
 */
function runEscrowReleaseWorker(): void {
    info("در حال بررسی وجوه امانی گذشته از موعد ۷ روزه ضمانت بازگشت...");
    require_once ASENA_ROOT . '/includes/App.php';
    $res = App::escrow()->releaseMaturedEscrow();
    success("عملیات آزادسازی وجوه منقضی شده با موفقیت انجام شد:");
    out("  تعداد اقلام آزاد شده: {$res['released_count']}");
    out("  مجموع مبلغ واریز شده به موجودی تسویه: " . number_format($res['total_amount']) . " تومان", '32');
    out("  تعداد فروشندگان متأثر: {$res['sellers_affected_count']}");
}

/**
 * Weekly Central Bank Paya Interbank Payout Batch Worker
 */
function runEscrowWeeklyPayoutWorker(): void {
    info("در حال پردازش چرخه تسویه حساب هفتگی و صدور فایل پایا...");
    require_once ASENA_ROOT . '/includes/App.php';
    $res = App::escrow()->generateWeeklyPayoutBatch(1);
    if ($res['success']) {
        success("بسته تسویه حساب هفتگی صادر شد:");
        out("  شناسه دسته پایا: {$res['batch_code']}", '32');
        out("  مجموع مبلغ تسویه شده: " . number_format($res['total_amount']) . " تومان", '32');
        out("  تعداد فروشندگان تسویه شده: {$res['seller_count']}");
    } else {
        warn($res['message']);
    }
}

/**
 * Database Restore CLI Tool
 */
function runDatabaseRestore(string $filepath): void {
    if (empty($filepath)) {
        error("لطفاً مسیر فایل بکاپ را مشخص کنید: php bin/asena db:restore <filepath>");
        return;
    }

    if (!file_exists($filepath)) {
        error("فایل بکاپ در مسیر مشخص شده یافت نشد: $filepath");
        return;
    }

    info("در حال بازیابی اطلاعات پایگاه داده از فایل: " . basename($filepath) . "...");
    require_once ASENA_ROOT . '/includes/db.php';
    $pdo = $GLOBALS['pdo'];

    try {
        $sql = file_get_contents($filepath);
        $pdo->exec($sql);
        success("بازیابی پایگاه داده با موفقیت انجام شد.");
    } catch (Exception $e) {
        error("خطا در بازیابی: " . $e->getMessage());
    }
}

/**
 * Helper to parse CLI arguments
 */
function parseArgs(array $args): array {
    $result = [];
    foreach ($args as $arg) {
        if (strpos($arg, '--') === 0) {
            $parts = explode('=', substr($arg, 2), 2);
            $result[$parts[0]] = $parts[1] ?? true;
        }
    }
    return $result;
}

/**
 * Display help instructions
 */
function showHelp(): void {
    out("ASENA Enterprise CLI Tool\n", '34');
    out("دستورات موجود:");
    out("  php bin/asena status                         مشاهده وضعیت نسخه فعال و قابلیت‌ها");
    out("  php bin/asena set-tier <tier>                تغییر نسخه در حال اجرا (basic, standard, premium, pharmacy, enterprise)");
    out("  php bin/asena package --tier=<tier>          تولید فایل زیپ اختصاصی برای هاست خریدار");
    out("  php bin/asena autoship:run                   اجرای موتور اتوشیپ و ارسال پیامک‌های نوبت (Chewy)");
    out("  php bin/asena escrow:sync-post               استعلام خودکار تحویل از وب‌سرویس پست ایران و آغاز مهلت ۷ روزه");
    out("  php bin/asena escrow:release-matured         آزادسازی وجوه امانی سپری شده از موعد ۷ روزه به موجودی تسویه");
    out("  php bin/asena escrow:weekly-payout           اجرای چرخه هفتگی تسویه، صدور فایل پایا (بانک مرکزی) و ارسال پیامک");
    out("  php bin/asena b2b:rfq-expire                 منقضی‌سازی پیش‌فاکتورهای گذشته از موعد استعلام عمده (Alibaba)");
    out("  php bin/asena flash:sync                     همگام‌سازی و بستن پیشنهادات شگفت‌انگیز منقضی (Digikala)");
    out("  php bin/asena system:health                  بررسی سلامت زیرساخت، دیتابیس و دسترسی‌های دایرکتوری");
    out("  php bin/asena db:backup                      تهیه نسخه پشتیبان کامل از دیتابیس (SQL dump)");
    out("  php bin/asena db:restore <file>              بازیابی ایمن دیتابیس از فایل بکاپ");
    echo "\n";
}

