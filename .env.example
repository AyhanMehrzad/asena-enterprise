# ─── MELI PAYAMAK SMS CONFIGURATION ──────────────────────────────────────────
MELIPAYAMAK_API_KEY="your_melipayamak_token_here"
MELIPAYAMAK_USERNAME="your_username"
MELIPAYAMAK_PASSWORD="your_password"
MELIPAYAMAK_FROM="your_sender_number"
MELIPAYAMAK_TO="your_phone_number"

# ─── MELI PAYAMAK PATTERN BODY IDS (شناسه قالب‌های تایید شده در پنل) ────────────
MELIPAYAMAK_BODY_ID_OTP="12345"
MELIPAYAMAK_BODY_ID_BOOKING="12345"
MELIPAYAMAK_BODY_ID_RESCHEDULE="12345"
MELIPAYAMAK_BODY_ID_SHIPPING="12345"
MELIPAYAMAK_BODY_ID_SUBSCRIPTION="12345"
MELIPAYAMAK_BODY_ID_CHARITY="12345"
MELIPAYAMAK_BODY_ID_ADMIN_ORDER="12345"
MELIPAYAMAK_BODY_ID_DOCTOR_BOOKING="12345"

# ─── GOOGLE OAUTH CONFIGURATION ──────────────────────────────────────────────
GOOGLE_CLIENT_ID="131837445782-ar0fpgc5srtnpc3vkvjjl05d3lin62pu.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# ─── SMS GATEWAY RESILIENCE / SANDBOX ─────────────────────────────────────────
MELIPAYAMAK_SANDBOX="false"

# ─── IRAN POST TRACKING API ───────────────────────────────────────────────────
IRAN_POST_API_KEY="your_iran_post_api_key_here"
IRAN_POST_USERNAME="your_iran_post_username"
IRAN_POST_PASSWORD="your_iran_post_password"
IRAN_POST_SANDBOX="true"

# ─── CENTRAL BANK PAYA (پایا) PAYOUT GATEWAY ──────────────────────────────────
PAYA_BANK_GATEWAY_URL="https://api.paya-gateway.ir/v1/transfer"
PAYA_GATEWAY_API_KEY="your_paya_gateway_token_here"

# ─── TELEGRAM ADMIN NOTIFICATIONS ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_ADMIN_CHAT_ID="your_telegram_admin_chat_id"

# ─── CLOUDFLARE WAF & DDOS INTEGRATION ───────────────────────────────────────
CLOUDFLARE_ZONE_ID="your_cloudflare_zone_id_here"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"

# ─── POSTEX SHIPPING & LOGISTICS API ─────────────────────────────────────────
POSTEX_API_KEY="your_postex_api_key_here"
POSTEX_API_URL="https://api.postex.ir"
POSTEX_SANDBOX="true"
POSTEX_DEFAULT_FROM_CITY="1"

# ─── DEFENSE-IN-DEPTH CRYPTOGRAPHY & DATA SECURITY ───────────────────────────
APP_SECURITY_PEPPER="generate_64_character_hex_pepper_secret"
APP_DATA_ENCRYPTION_KEY="generate_64_character_hex_aes_encryption_key"
APP_BLIND_INDEX_KEY="generate_64_character_hex_blind_index_key"



